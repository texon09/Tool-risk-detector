# PlanGuard Secrets & Configuration

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# PlanGuard Backend API
PLANGUARD_URL=http://127.0.0.1:8000
PLANGUARD_API_KEY=

# PlanGuard Dashboard URL (for audit log deep links)
FRONTEND_URL=http://localhost:3000

# Optional Database URL (defaults to sqlite:///audit.db)
DATABASE_URL=sqlite:///audit.db

# Allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
